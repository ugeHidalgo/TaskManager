#!/usr/bin/env bash

set -euo pipefail

# Block common generated/build artifacts from being committed.
FORBIDDEN_SEGMENT_REGEX='(^|/)(bin|obj|node_modules|dist|\.vite|\.npm-cache)(/|$)'

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

if [[ -z "${staged_files}" ]]; then
  exit 0
fi

blocked_files=$(printf '%s\n' "${staged_files}" | grep -E "${FORBIDDEN_SEGMENT_REGEX}" || true)

if [[ -n "${blocked_files}" ]]; then
  echo "pre-commit: blocked generated artifacts in staged changes:" >&2
  printf '%s\n' "${blocked_files}" >&2
  echo >&2
  echo "Remove them from index and try again:" >&2
  echo "  git reset HEAD <path>" >&2
  echo "Then verify .gitignore rules." >&2
  exit 1
fi

exit 0
